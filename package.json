{
  "name": "@fabricmc/vitepress-versioning-plugin",
  "version": "1.7.0",
  "private": true,
  "description": "A highly customizable versioning plugin for VitePress v2",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./src/components/*": "./src/components/*"
  },
  "files": [
    "dist",
    "src/components"
  ],
  "type": "module",
  "scripts": {
    "prepublish": "tsdown",
    "build": "tsdown",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FabricMC/vitepress-versioning-plugin.git"
  },
  "keywords": [
    "vitepress",
    "versioning",
    "i18n",
    "plugin",
    "vite"
  ],
  "author": "Calum H. (imb11)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.5",
    "typescript": "^6.0.3",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "vitepress": "2.0.0-alpha.21",
    "vue": "^3.5.43"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "22.23.4",
      "onFail": "warn"
    }
  }
}
